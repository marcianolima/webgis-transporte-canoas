# Frontend: apenas URL pública, NUNCA credencial
VITE_BASE_PATH=/webgis-transporte-canoas/
VITE_PUBLIC_API_BASE=
# Backend e worker: somente servidor
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://transporte:SUBSTITUIR@db:5432/transporte
ADMIN_API_KEY=
PUBLIC_ORIGINS=https://marcianolima.github.io
SOURCE_HOMOLOGATED=false
GPS_FEED_URL=
GPS_FEED_ALLOWED_HOST=
GPS_FEED_TOKEN=
GPS_INTERVAL_SECONDS=60

# TACOM: opt-in no servidor apenas. Fica desativado por padrão.
# PUBLIC_POSITIONS_ENABLED é autorização separada de PUBLICAÇÃO pública;
# SOURCE_HOMOLOGATED deve continuar false sem homologação temporal integral.
PUBLIC_POSITIONS_ENABLED=false
GOBUS_READ_AUTHORIZED=false
GOBUS_ACCEPT_HTTP=false
GOBUS_REQUEST_SPACING=15
GOBUS_CYCLE_SECONDS=180

# Tetos cumulativos persistidos por hora/dia na rede da TACOM
GOBUS_MAX_PER_HOUR=120
GOBUS_MAX_PER_DAY=1000
